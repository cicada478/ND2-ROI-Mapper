root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4
max_line_length = 100

[*.{md,txt,toml,ps1,spec,template,sh,yml,yaml}]
indent_style = space
indent_size = 2

[*.{vbs,iss}]
end_of_line = crlf
indent_style = space
indent_size = 4
